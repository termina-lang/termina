interface ISensor {
    procedure set(&mut self, v : u32);
};

resource class CSensor provides ISensor {
    value : u32;

    procedure set(&mut self, v : u32) {
        self->value = v;
        return;
    }

    case sets_the_value(&mut self) {
        self->value = 1 : u32;
        return;
    }
};
